rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Your planner data: only you can read or write it
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Your reminder list + device tokens (the GitHub Action reads it with admin access)
    match /push/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
